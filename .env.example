# Porta do servidor
PORT=3333

# Ambiente (development | production)
NODE_ENV=development

# URL de conexão com o PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/fintech_flow?schema=public"

# Chave secreta para assinatura dos tokens JWT (ALTERE EM PRODUÇÃO)
JWT_SECRET="sua-chave-secreta-aqui"

# Tempo de expiração do JWT (ex: 7d, 24h, 1h)
JWT_EXPIRES_IN="7d"

# Número de rounds do bcrypt para hash de senha
BCRYPT_SALT_ROUNDS=12

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
